parameters:
    ignoreErrors:
        # Symfony Console declares option values more narrowly than the runtime values accepted here.
        - { identifier: notIdentical.alwaysTrue, path: src/Console/GrigliaCheck.php, count: 1 }
        - { identifier: arrayValues.list, path: src/Console/GrigliaCheck.php, count: 1 }
        - { identifier: argument.type, path: src/Console/GrigliaCheck.php, count: 3 }
        # These guarded fallbacks intentionally tolerate partially populated command payloads and missing rows.
        - { identifier: nullCoalesce.offset, path: src/Console/GrigliaCheck.php, count: 1 }
        - { identifier: nullsafe.neverNull, path: src/Console/GrigliaCheck.php, count: 1 }

        # Eloquent relation create/find/query results keep the concrete model at runtime; Larastan loses it here.
        - { identifier: return.type, path: src/Domain/ReviewWorkflow.php, count: 1 }
        - { identifier: method.notFound, path: src/Livewire/ChecklistSwitcher.php, count: 1 }
        - { identifier: return.type, path: src/Livewire/IngredientModal.php, count: 1 }
        - { identifier: return.type, path: src/Livewire/PlanPage.php, count: 1 }
        - { identifier: argument.type, path: src/Livewire/PlanPage.php, count: 1 }
        - { identifier: method.notFound, path: src/Livewire/PlansPage.php, count: 1 }
        - { identifier: return.type, path: src/Livewire/PlansPage.php, count: 1 }
        - { identifier: argument.type, path: src/Livewire/TodoList.php, count: 1 }
        - { identifier: argument.type, path: src/Models/Todo.php, count: 2 }
        - { identifier: method.notFound, path: src/Support/Context.php, count: 2 }
        - { identifier: return.type, path: src/Support/ImageStore.php, count: 1 }
        - { identifier: method.notFound, path: src/Support/Plan.php, count: 1 }
        - { identifier: return.type, path: src/Support/QuestionLevel.php, count: 1 }

        # SoftDeletes forwards withTrashed through Eloquent builders/relations, which PHPStan cannot see.
        - { identifier: method.notFound, path: src/Livewire/StatsPage.php, count: 3 }
        - { identifier: method.notFound, path: src/Models/Checklist.php, count: 1 }
        - { identifier: method.notFound, path: src/Support/Stats.php, count: 1 }

        # Defensive nullsafe/fallback branches support older or user-supplied data despite inferred non-null types.
        - { identifier: nullCoalesce.offset, path: src/Http/Controllers/ThemeAssetController.php, count: 1 }
        - { identifier: nullsafe.neverNull, path: src/Livewire/DashboardTodoList.php, count: 1 }
        - { identifier: nullsafe.neverNull, path: src/Livewire/IngredientModal.php, count: 1 }
        - { identifier: nullsafe.neverNull, path: src/Livewire/StatsPage.php, count: 1 }
        - { identifier: nullsafe.neverNull, path: src/Livewire/ThemedTodoList.php, count: 1 }
        - { identifier: nullsafe.neverNull, path: src/Livewire/TodoList.php, count: 1 }

        # Compatibility guards deliberately support multiple Laravel AI / PHP extension versions and invalid input.
        - { identifier: function.alreadyNarrowedType, path: src/Http/Controllers/TranscribeController.php, count: 1 }
        - { identifier: match.unhandled, path: src/Support/ImageStore.php, count: 1 }
        - { identifier: notIdentical.alwaysTrue, path: src/Support/Locale.php, count: 1 }
        - { identifier: notIdentical.alwaysTrue, path: src/ThemeStore.php, count: 1 }

        # The parser closure mutates a by-reference accumulator; PHPStan does not track that closure effect.
        - { identifier: booleanOr.alwaysTrue, path: src/Support/Context.php, count: 1 }
        - { identifier: identical.alwaysTrue, path: src/Support/Context.php, count: 1 }
        - { identifier: deadCode.unreachable, path: src/Support/Context.php, count: 1 }
